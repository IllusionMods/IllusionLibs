<?xml version="1.0"?>
<package xmlns="http://schemas.microsoft.com/packaging/2013/05/nuspec.xsd">
  <metadata>
    <id>$id$</id>
    <version>1.0.0.0</version>
    <description>Common utilities for Hooh plugins</description>
    <authors>Hooh</authors>
